{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": ["Bash", "Read", "Edit", "Write", "Glob", "Grep", "NotebookEdit", "WebFetch", "WebSearch", "Agent", "Task", "mcp__playwright", "mcp__browser"],
    "deny": [
      "Bash(sudo:*)", "Bash(su:*)", "Bash(git push:*)", "Bash(gh:*)", "Bash(ssh:*)", "Bash(scp:*)", "Bash(rsync:*)",
      "Bash(nc:*)", "Bash(systemctl:*)", "Bash(crontab:*)",
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.production)",
      "Read(~/.ssh/**)", "Read(~/.gnupg/**)", "Read(~/.config/**)", "Read(~/.claude/**)",
      "Read(~/.claude.json)", "Read(~/.local/state/**)",
      "Read(~/.local/share/keyrings/**)", "Read(~/.mozilla/**)", "Read(~/snap/**)", "Read(~/.aws/**)", "Read(~/.netrc)",
      "Read(~/.git-credentials)", "Read(~/.bash_history)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/harness/guard.sh\"" } ] }
    ]
  }
}
