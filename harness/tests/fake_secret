#!/usr/bin/env python3
"""Stand-in for the droplet's `secret` helper (OpenBao), used by selftest.sh. Same interface:
  secret [--project P] get KEY | set KEY VALUE | set KEY - (stdin) | ls | env KEY...
Project: --project, else SECRET_PROJECT, else `claude`. Token: BAO_TOKEN, else ~/.config/openbao/<project>.token.
Store: the JSON file $FAKE_VAULT, {"<project>": {"token": "...", "keys": {"NAME": "value"}}}. Like a per-project
OpenBao token, a token opens only its own project; a wrong token or an unknown key exits 1, never showing a value."""
import json, os, shlex, sys
from pathlib import Path

args = sys.argv[1:]
project = os.environ.get("SECRET_PROJECT") or "claude"
if args[:1] == ["--project"]:
    project, args = args[1], args[2:]
tf = Path.home() / ".config" / "openbao" / f"{project}.token"
token = os.environ.get("BAO_TOKEN") or (tf.read_text().strip() if tf.is_file() else "")
store = Path(os.environ["FAKE_VAULT"])
db = json.loads(store.read_text())
if project not in db or not token or db[project]["token"] != token:
    sys.exit(f"secret: permission denied for project {project}")
keys = db[project]["keys"]
cmd = args[0] if args else ""
if cmd == "ls":
    print("\n".join(sorted(keys)))
elif cmd == "get" and len(args) == 2 and args[1] in keys:
    print(keys[args[1]])
elif cmd == "set" and len(args) == 3:
    keys[args[1]] = sys.stdin.read().rstrip("\n") if args[2] == "-" else args[2]
    store.write_text(json.dumps(db))
elif cmd == "env" and len(args) > 1 and all(k in keys for k in args[1:]):
    print("\n".join(f"export {k}={shlex.quote(keys[k])}" for k in args[1:]))
else:
    sys.exit(f"secret: bad command or unknown key: {' '.join(args[:2])}")
