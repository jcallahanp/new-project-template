#!/usr/bin/env python3
"""Stand-in for `claude -p` used by selftest.sh. Reads the brief on stdin and does what a session of
that kind would do for a toy project (two tiny CLI programs), including some bad behaviour the loop
must survive: one provider error, a short 429 rate limit on M1.T3's first work leg, a usage limit on
the first plan leg, on the first Opus work leg of M1.T2 and on M1.T3's first Opus verify leg, a usage
a 429 on M2.T1's Opus work leg that outlasts the short retries (so it falls back) and a usage limit on
its Fable fallback (waited out, then back on Opus), a 429 on the M1 round-2 plan leg that outlasts the
short retries (waited out), an attempt to edit the ledger
and a check, a first M1.T1 that fails its check (so attempt 2 runs), a first version with a bug that only an acceptance check notices (so the milestone is planned
again while R1 already passes), a bug that only the auditor notices, and VERDICT/GAP lines wrapped in
markdown. Prints one JSON result line like Claude Code does, with usage (the auditor's has none), and
logs "<KIND> <model> <effort> <task>" per call to $MOCK_STATE/calls."""
import json, os, re, subprocess, sys
from pathlib import Path

state = Path(os.environ["MOCK_STATE"]); state.mkdir(parents=True, exist_ok=True)
prompt = sys.stdin.read()
argv = sys.argv[1:]
model = argv[argv.index("--model") + 1] if "--model" in argv else "?"
effort = argv[argv.index("--effort") + 1] if "--effort" in argv else "-"


def count(name):
    f = state / name
    n = int(f.read_text()) + 1 if f.exists() else 1
    f.write_text(str(n))
    return n


def out(text, error=False, usage=True):
    res = {"type": "result", "subtype": "success", "is_error": error, "result": text, "num_turns": 3, "permission_denials": []}
    if usage:
        res.update(total_cost_usd=0.125, usage={"input_tokens": 1000, "output_tokens": 200, "cache_read_input_tokens": 5000,
                                                "cache_creation_input_tokens": 300},
                   modelUsage={model: {"inputTokens": 1000, "outputTokens": 200, "costUSD": 0.125}})
    print(json.dumps(res))
    sys.exit(1 if error else 0)


LIMIT = "Claude AI usage limit reached · resets 3am"


def write(path, text, mode=None):
    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(text)
    if mode: p.chmod(mode)


def commit(msg):
    subprocess.run(["git", "add", "-A"], check=True)
    subprocess.run(["git", "commit", "-q", "-m", msg], check=True)


kind = re.match(r"You are (?:the |a )(\w+) session", prompt).group(1)
tid = (re.search(r"TASK (M\d+\.T\d+)", prompt) or [None, "-"])[1]
with open(state / "calls", "a") as f:
    f.write(f"{kind} {model} {effort} {tid}\n")
if kind == "DESIGN":
    write("spec/DESIGN.md", "# Design\n\n" + "Two small Python command-line programs under app/. " * 20 + "\n\n## Running and testing\n\npython3 app/add.py 2 3\n")
    write("plan/milestones.json", json.dumps([{"id": "M1", "title": "Both calculators", "goal": "app/add.py and app/sub.py print the right result for integers.", "requirements": ["R1", "R2"]}]))
    write("checks/check_project.sh", '#!/usr/bin/env bash\nls app/*.py >/dev/null 2>&1 || { echo "  no app yet: skipped"; exit 0; }\npython3 -m py_compile app/*.py && echo "  compiles"\n')
    write("init.sh", "#!/usr/bin/env bash\necho nothing to install\n")
    out("stack: python; 1 milestone; risk: none")
if kind == "PLANNER":
    if count("planner") == 1:
        out(LIMIT, error=True)                                                    # a plan leg must wait this out
    if "plan/M1.r2.jsonl" in prompt and count("rate-plan") <= 3:
        out("Rate limit reached for claude-fable-5-2", error=True)                 # persists past the short retries: wait, never stop
    mid = re.search(r"milestone (M\d+)", prompt).group(1)
    plan_file = re.search(r"`(plan/M\d+\.r\d+\.jsonl)`", prompt).group(1)
    first = int(re.search(r'"id": "T(\d+)"', prompt).group(1))
    if plan_file == "plan/M1.r2.jsonl":     # acceptance replan: R2 fails, R1 passes and is frozen (no task, no edit)
        tasks = [{"id": f"T{first}", "title": "Make app/sub.py read whole numbers", "acceptance": "python3 app/sub.py 12 2 prints 10 on one line", "requirements": ["R2"], "files": ["app/sub.py"], "depends_on": []}]
        write(f"checks/tasks/M1.T{first}.sh", '[ "$(python3 app/sub.py 12 2)" = 10 ]\n')
    elif mid == "M1":
        tasks = [{"id": f"T{first}", "title": "Write app/add.py", "acceptance": "python3 app/add.py 2 3 prints 5 on one line", "requirements": ["R1"], "files": ["app/add.py"], "depends_on": []},
                 {"id": f"T{first + 1}", "title": "Write app/sub.py", "acceptance": "python3 app/sub.py 5 3 prints 2 on one line", "requirements": ["R2"], "files": ["app/sub.py"], "depends_on": [f"T{first}"]}]
        write(f"checks/tasks/M1.T{first}.sh", '[ "$(python3 app/add.py 2 3)" = 5 ]\n')
        write(f"checks/tasks/M1.T{first + 1}.sh", '[ "$(python3 app/sub.py 5 3)" = 2 ]\n')
        write("checks/acceptance/R1.sh", '[ "$(python3 app/add.py 2 3)" = 5 ] && [ "$(python3 app/add.py -1 1)" = 0 ]\n')
        write("checks/acceptance/R2.sh", '[ "$(python3 app/sub.py 5 3)" = 2 ] && [ "$(python3 app/sub.py 12 2)" = 10 ]\n')
    else:                                   # audit-fix milestone: expose the gap with a failing check
        tasks = [{"id": f"T{first}", "title": "Fix app/sub.py for negative results", "acceptance": "python3 app/sub.py 2 5 prints -3 on one line", "requirements": ["R2"], "files": ["app/sub.py"], "depends_on": []}]
        write(f"checks/tasks/{mid}.T{first}.sh", '[ "$(python3 app/sub.py 2 5)" = -3 ]\n')
        write("checks/acceptance/R2.sh", '[ "$(python3 app/sub.py 5 3)" = 2 ] && [ "$(python3 app/sub.py 12 2)" = 10 ] && [ "$(python3 app/sub.py 2 5)" = -3 ]\n')
        write("checks/acceptance/R1.sh", "exit 0\n")           # not allowed (R1 is frozen): the loop must undo this
    write(plan_file, "".join(json.dumps(t) + "\n" for t in tasks))
    out(f"{len(tasks)} tasks")
if kind == "WORKER":
    attempt = int(re.search(r"ATTEMPT: (\d+)", prompt).group(1))
    if count("worker") == 1:
        out('API Error: 524 {"title":"Error 524: A timeout occurred"}', error=True)   # provider hiccup: must be retried
    if tid == "M1.T2" and model == "claude-opus-5-5" and count("limit-work") == 1:
        out(LIMIT, error=True)                                                    # a work leg must switch model at once
    if tid == "M1.T3" and count("rate-work") == 1:                                # short rate limit: same model, short wait
        out('API Error: 429 {"type":"error","error":{"type":"rate_limit_error","message":"per-minute rate limit exceeded"}}', error=True)
    if tid == "M2.T1" and model == "claude-opus-5-5" and count("rate-m2-opus") <= 3:   # a 429 that persists: fallback
        out('API Error: 429 {"type":"error","error":{"type":"rate_limit_error","message":"rate limit exceeded"}}', error=True)
    if tid == "M2.T1" and model == "claude-fable-5-2" and count("limit-m2-fable") == 1:  # fallback limited too: wait, then Opus
        out(LIMIT, error=True)
    if tid == "M1.T1":
        add = "int(sys.argv[1]) + int(sys.argv[2])" if attempt > 1 else "int(sys.argv[1]) * int(sys.argv[2])"   # attempt 1 fails its check
        write("app/add.py", f"import sys\nprint({add})\n")
        with open("ledger.jsonl", "a") as f: f.write('{"id": "FAKE", "kind": "task", "state": "done"}\n')   # tampering: must be undone
        write("checks/tasks/M1.T2.sh", "exit 0\n")                                                          # tampering: must be undone
    elif tid == "M1.T2":
        write("app/sub.py", "import sys\nprint(abs(int(sys.argv[1][-1]) - int(sys.argv[2][-1])))\n")        # bugs: last digit only (R2.sh notices), abs
    elif tid == "M1.T3":
        write("app/sub.py", "import sys\nprint(abs(int(sys.argv[1]) - int(sys.argv[2])))\n")                # bug only the auditor notices
    else:
        write("app/sub.py", "import sys\nprint(int(sys.argv[1]) - int(sys.argv[2]))\n")
    commit(f"{tid}: work")
    out("done")
if kind == "VERIFIER":
    if tid == "M1.T3" and model == "claude-opus-5-5" and count("limit-verify") == 1:
        out(LIMIT, error=True)                                                    # a verify leg must switch model at once
    out("Looked at the diff and ran the check.\n\n> **VERDICT: PASS** — the change meets the criterion")   # markdown around the verdict
if kind == "AUDITOR":                       # no usage fields: the loop must record zeros and no cost
    if count("audit") == 1:
        out("- **GAP: R2** – app/sub.py 2 5 prints 3, not -3 (it takes the absolute value)\n\n**VERDICT: FAIL**", usage=False)
    out("Tried every example by hand.\n\n## VERDICT: PASS", usage=False)
out("unknown brief", error=True)
